{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://os-taxonomy-beijing.github.io/schema/cn-dependencies.schema.json",
  "title": "Beijing Skill Taxonomy — 中国特有微主题依赖（cn-dependencies）",
  "description": "mtc_ 主题之间的知识依赖 DAG（无环）。topicId depends on prerequisiteId（学 X 前需先掌握 Y）。reviewStatus 标识每条边的人工审核状态：machine=LLM/规则产出未审核，reviewed=已审核，rejected=已拒绝。默认 viewer 只展示 reviewed 边给儿童。",
  "type": "object",
  "required": ["version", "edgeCount", "dependencies"],
  "properties": {
    "version": { "type": "string" },
    "upstreamVersion": { "type": "string" },
    "locale": { "type": "string" },
    "edgeCount": { "type": "integer", "minimum": 0 },
    "note": { "type": "string" },
    "generationBatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "model", "generatedAt", "strategy"],
        "properties": {
          "id": { "type": "string" },
          "model": { "type": "string" },
          "inputFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$", "description": "历史批次未知时为 null" },
          "generatedAt": { "type": "string" },
          "strategy": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["topicId", "prerequisiteId", "strength"],
        "properties": {
          "topicId": {
            "type": "string",
            "pattern": "^mtc_",
            "description": "依赖方（学这个主题需要先掌握 prerequisiteId）"
          },
          "prerequisiteId": {
            "type": "string",
            "pattern": "^mtc_",
            "description": "被依赖方（先修知识）"
          },
          "strength": {
            "type": "string",
            "enum": ["hard", "soft"],
            "description": "hard=硬前置（必须先学）；soft=软前置（建议先学，渐进）"
          },
          "reason": { "type": ["string", "null"], "description": "依赖说明（中文）" },
          "reviewStatus": {
            "type": "string",
            "enum": ["machine", "reviewed", "rejected"],
            "description": "审核状态：machine=未审核（不进入儿童 API/路径）；reviewed=已通过审核（证据等级见 reviewProvenance）；rejected=已拒绝。缺失视为 machine（向后兼容）。"
          }
          ,"reviewProvenance": {
            "type": "string",
            "enum": ["rule", "ai-consensus", "human"],
            "description": "审核结论的证据等级：rule=确定性规则脚本产出；ai-consensus=用户授权的 AI 复审；human=人工审核。仅当 reviewStatus 为 reviewed/rejected 时出现。upstream 只在服务端合并期标记，不写入数据文件。"
          }
          ,"rescopeRequired": { "type": "boolean", "description": "主题拆分后，旧边语义已收窄，必须重新审核" },
          "previousReviewStatus": { "type": "string", "enum": ["reviewed"], "description": "拆分重定责前的审核状态" },
          "rescopeBatchId": { "type": "string", "description": "触发重定责的拆分批次" },
          "ageRegression": { "type": "boolean", "description": "同学段内先修起始年龄高于目标，需人工复核" },
          "generationBatchId": { "type": "string", "description": "机器关系生成批次" },
          "reviewedBy": { "type": "string", "description": "人工审核人标识" },
          "reviewedAt": { "type": "string", "description": "人工审核时间" },
          "reviewNote": { "type": "string", "description": "人工审核说明" },
          "reviewerRole": { "type": "string", "enum": ["curator", "teacher"], "description": "teacher 需要 reviewRubric 与 reviewEvidenceRef；curator 不代表教师审核" },
          "reviewRubric": { "type": "string" },
          "reviewEvidenceRef": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
