# build-deps-llm.mjs 用的 LLM 配置（OpenAI 兼容接口）
# 复制本文件为 .env，填入你的 key，然后运行：
#   node scripts/build-deps-llm.mjs --plan      # 先看分桶和 prompt
#   node scripts/build-deps-llm.mjs --dry-run   # 调模型但不写盘
#   node scripts/build-deps-llm.mjs             # 正式写盘

# 任选一家（都支持 response_format=json_object）：
#
# 智谱 GLM:    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-plus
# 通义千问:     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
# 豆包:        LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3  LLM_MODEL=doubao-pro-32k
# Moonshot:    LLM_BASE_URL=https://api.moonshot.cn/v1   LLM_MODEL=moonshot-v1-32k
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1    LLM_MODEL=gpt-4o-mini

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
